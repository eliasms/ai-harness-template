# {{PROJECT_NAME}} — Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e configure com seus valores reais.
# NUNCA comite o arquivo .env no Git. Este arquivo NÃO deve conter segredos reais.

# Ambiente
ASPNETCORE_ENVIRONMENT=Development

# Autenticação & Segurança
AUTH_ALLOW_SELF_REGISTRATION=true
AUTH_ENFORCE_MFA_ONBOARDING=false
AUTH_BYPASS_MFA_FOR_TESTS=false        # só tem efeito com ASPNETCORE_ENVIRONMENT=Testing
ADMIN_DEFAULT_EMAIL=admin@example.local
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Infraestrutura (ajuste conforme o docker-compose do projeto)
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Provedores de IA externos (opcional)
# <PROVEDOR>_API_KEY=your_api_key_here